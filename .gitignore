# Build output.
/target

# Plugin bundles, which `cargo xtask bundle` writes into target/ anyway but
# which people sometimes copy up a level while testing.
/bundled
*.clap
*.vst3

# Editor and OS droppings
*~
*.swp
*.rs.bk
.DS_Store
.idea/
.vscode/

# Manufacturers' schematics. They are what the models in src/circuits were
# built from and they belong on the bench, not in the repository: they are
# somebody else's drawings, and publishing them is not ours to do. The modules
# quote the values and say what they mean, which is the part that is ours.
/docs/schematics/
/tools/speaker_fit/

# Keep the panel image; other documentation stays local.
/docs/*
!/docs/panel.png
!/docs/MODEL_INVENTORY.md

# Version the model research logs; original drawings remain excluded.
!/docs/models/
!/docs/models/**

# Version the solver engineering record too. IMPLEMENTATION_PROGRESS.md is
# versioned and points at these two, so leaving them local would ship a
# dangling reference to the file that is supposed to explain the work.
!/docs/SOLVER_OPTIMIZATION.md
!/docs/SOLVER_EXPERIMENTS.md

CLAUDE.md
AGENTS.md
